        "name": "Busca horários (Calendly)"
      },
      {
        "parameters": {
          "jsCode": "// Monta o report de disponibilidade agrupado por dia (fuso BR).\n// Entrada: corpo do GET /event_type_available_times -> { collection: [{start_time, status, ...}] }\nconst DIAS = 5;\nconst AGENDA = \"Agenda Money Club\";\nconst col = ($json.collection || []).filter((c) => c.status === 'available');\n\nconst fmt = (iso, opts) => new Intl.DateTimeFormat('pt-BR',\n  { timeZone: 'America/Sao_Paulo', ...opts }).format(new Date(iso));\nconst cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);\n\n// Agrupa por dia preservando a ordem que o Calendly já devolve (crescente).\nconst porDia = new Map();\nfor (const c of col) {\n  const chave = fmt(c.start_time, { day: '2-digit', month: '2-digit' });\n  const rotulo = cap(fmt(c.start_time, { weekday: 'long' })) + ', ' + chave;\n  if (!porDia.has(rotulo)) porDia.set(rotulo, []);\n  porDia.get(rotulo).push(fmt(c.start_time, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }));\n}\n\nlet message = `*Report Diário — ${AGENDA}*\\n`;\nif (!porDia.size) {\n  message += `\\n⚠️ *Sem horários disponíveis* nos próximos ${DIAS} dias.`;\n} else {\n  for (const [rotulo, horas] of porDia) {\n    message += `\\n*${rotulo}* (${horas.length} ${horas.length === 1 ? 'horário' : 'horários'})\\n`;\n    message += horas.join(' · ') + '\\n';\n  }\n  message += `\\n_Total: ${col.length} ${col.length === 1 ? 'horário' : 'horários'} nos próximos ${DIAS} dias._`;\n}\nreturn [{ json: { message, total: col.length, dias: porDia.size } }];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          480,
          80
        ],
        "id": "ce1d523f-4bec-4334-a45d-0adcfd6c5d36",
        "name": "Monta report"
      },
