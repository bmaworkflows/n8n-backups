      {
        "parameters": {
          "jsCode": "// Monta o corpo do report (usado nos 2 ramos) + telefone do lead normalizado.\n// Acesso SEGURO em tudo: num parcial as chaves de answers podem nem existir.\nconst CAMPOS = [[\"6aa81aa0fa212145270cb341\", \"Nome do lead\"], [\"6aa81aa9fa212145270cb34b\", \"E-mail\"], [\"6aa81ac208abbe9b700c7bf2\", \"Instagram\"], [\"6aa81ab6bdc098b4850bb6e6\", \"Whatsapp\"], [\"6aa81aded4bc0a887400a75b\", \"Faturamento\"], [\"6aa81afc08abbe9b700c7bf9\", \"Momento profissional\"], [\"6aa81b45fa212145270cb34f\", \"Clientes ativos\"], [\"6aa81b7a9e5821dda40f9906\", \"Objetivo (próximos meses)\"], [\"6aa81b8bc70318ff7c0022d4\", \"Principal dificuldade hoje\"], [\"6aa81babcd15df89ce020b36\", \"Por que resolver agora\"], [\"6aa81bc3d4bc0a887400a75e\", \"Por que escolher esta aplicação\"], [\"6aa81c069e5821dda40f9910\", \"Confirmou compromisso\"]];\nconst resp = $('Trata Webhook').item.json.response || {};\nconst ans = resp.answers || {};\nconst val = (id) => {\n  const c = ans[id]?.content;\n  if (c === null || c === undefined) return '';\n  if (c === true) return 'Sim';\n  if (c === false) return 'Não';\n  return Array.isArray(c) ? c.filter(Boolean).join(', ') : String(c);\n};\n// Campo vazio não vira linha: no parcial metade das perguntas não existe.\nconst linhas = CAMPOS.map(([id, rot]) => {\n  const v = val(id);\n  return v ? `*${rot}*: ${v}` : null;\n}).filter(Boolean);\nconst t = resp.tracking || {};\nconst utm = ['utm_source', 'utm_campaign', 'utm_medium', 'utm_content', 'utm_term']\n  .map((k) => `${k}: ${t[k] || ''}`).join('\\n');\nconst report = linhas.join('\\n\\n')\n  + '\\n\\n*Origens:*\\nFormulário: Money Club - Aplicação (yay forms)\\n\\n' + utm;\n// Z-API quer só dígitos com DDI; o Yay entrega '+5519971501794'.\nlet leadPhone = val('6aa81ab6bdc098b4850bb6e6').replace(/\\D/g, '');\nif (leadPhone && !leadPhone.startsWith('55')) leadPhone = '55' + leadPhone;\nreturn [{ json: { ...$json, report, leadPhone } }];\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          416,
          0
        ],
        "id": "dd46659a-e9f6-41f5-87ec-e5f95f998d8f",
        "name": "Resumo do form"
      },
      {
        "parameters": {
          "jsCode": "// Link do Calendly do campo 6aa81c449e5821dda40f9912. O Yay grava em 2 formatos:\n//   https://calendly.com/scheduled_events/<uuid>/invitees/<uuid>\n//   https://calendly.com/app/scheduled_events/user/me?period=all_time&uuid=<uuid>\n// Os dois têm que casar — o detector dos funis do JP só pega o primeiro.\nconst F_CAL = '6aa81c449e5821dda40f9912', F_FAT = '6aa81aded4bc0a887400a75b';\nconst DESQ = [\"Até R$ 10 mil\", \"De R$ 20 mil a R$ 30 mil\"];\nconst resp = $('Trata Webhook').item.json.response || {};\nconst ans = resp.answers || {};\nconst c = ans[F_CAL]?.content;\nlet eventUuid = null, link = null;\nif (typeof c === 'string' && c.includes('calendly.com')) {\n  const m = c.match(/scheduled_events\\/([0-9a-fA-F-]{36})/) || c.match(/[?&]uuid=([0-9a-fA-F-]{36})/);\n  if (m) { eventUuid = m[1]; link = c.trim(); }\n}\n// Rótulo do report do parcial. Só vale no ramo false (com link, vai pro ramo agendado).\nconst fat = ans[F_FAT]?.content?.[0] || '';\nconst completa = !!resp.submittedAt;\nconst situacao = !completa\n  ? 'parcial — abandonou o formulário (não finalizou)'\n  : (DESQ.includes(fat)\n      ? 'desqualificado pelo faturamento (o form encerra antes do calendário)'\n      : 'chegou no calendário e não agendou');\nreturn [{ json: { ...$json, agendou: !!eventUuid, calendlyLink: link, eventUuid, completa, situacao } }];\n"
        },
        "type": "n8n-nodes-base.code",
