      {
        "parameters": {
          "jsCode": "// dia/hora BR do evento + os 2 guards do pré-call.\nconst ev = $('3 · Busca evento').item.json.resource;\nconst p = new Intl.DateTimeFormat('pt-BR', {\n  timeZone: 'America/Sao_Paulo', day: '2-digit', month: '2-digit', year: 'numeric',\n  hour: '2-digit', minute: '2-digit', hourCycle: 'h23',\n}).formatToParts(new Date(ev.start_time));\nconst g = (t) => p.find((x) => x.type === t).value;\nconst dataHora = `${g('day')}/${g('month')} às ${g('hour')}:${g('minute')}`;       // msg ao lead\nconst dataHoraGrupo = `${g('day')}/${g('month')}/${g('year')} ${g('hour')}:${g('minute')}`;  // report\n// Pré-call só em resposta COMPLETA (com parcial ligado o mesmo lead gera 2 webhooks)\n// e só com evento ativo (agendou e cancelou antes do webhook -> não confirma nada).\nconst completa = $('1 · Detecta link Calendly').item.json.completa;\nconst ativo = ev.status === 'active';\nconst precallOk = completa && ativo;\n// O grupo é avisado quando o report sai sem pré-call; string vazia no caso normal.\nconst alertaStatus = precallOk ? '' :\n  `*⚠️ Sem pré-call automático* (${!ativo ? 'evento ' + ev.status : 'resposta parcial, aguardando o lead finalizar'})\\n\\n`;\nreturn [{ json: { ...$json, dataHora, dataHoraGrupo, precallOk, alertaStatus,\n  statusEvento: ev.status, joinUrl: ev.location?.join_url || '' } }];\n"
        },
