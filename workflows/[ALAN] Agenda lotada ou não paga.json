        "name": "Trata Webhook"
      },
      {
        "parameters": {
          "jsCode": "// Monta o resumo do form (parcial ou completo) + saudação e telefone do lead.\n// Acesso SEGURO em tudo: num parcial as chaves de answers podem nem existir.\nconst CAMPOS = [[\"6a92da4b8490fde669082a69\", \"Nome\"], [\"6a92da4b8490fde669082a6a\", \"WhatsApp\"], [\"6a92da4b8490fde669082a6b\", \"Instagram\"], [\"6a92da4b8490fde669082a6c\", \"E-mail\"], [\"6a92da4b8490fde669082a6e\", \"Faturamento mensal\"], [\"6a92da4b8490fde669082a6d\", \"Ticket da mentoria\"], [\"6a92da4b8490fde669082a76\", \"Agendamentos/mês hoje\"], [\"6a92dcda8490fde669082a96\", \"Agendamentos desejados/mês\"], [\"6a92dc8ec7270f5d1f0c51d6\", \"Como gera agendamentos\"], [\"6a92dc7b8490fde669082a94\", \"O que mais frustra\"], [\"6a92dc16c7270f5d1f0c51d5\", \"Calls/mês (qualificadas)\"], [\"6a92dc0f7c86920578073b58\", \"Já rodou tráfego / investe quanto\"], [\"6a92dbfc7c86920578073b57\", \"Tem gestor de tráfego\"], [\"6a92da4b8490fde669082a77\", \"Disponível pra investir\"], [\"6a92da4b8490fde669082a70\", \"Por que agora\"], [\"6a92da4b8490fde669082a71\", \"Por que deveríamos aceitar\"]];\nconst resp = $('Trata Webhook').item.json.response || {};\nconst ans = resp.answers || {};\nconst val = (id) => {\n  const c = ans[id]?.content;\n  if (c === null || c === undefined) return '';\n  if (c === true) return 'Sim';\n  if (c === false) return 'Não';\n  return Array.isArray(c) ? c.filter(Boolean).join(', ') : String(c);\n};\nconst linhas = CAMPOS.map(([id, rot]) => {\n  const v = val(id);\n  return v ? `*${rot}:* ${v}` : null;\n}).filter(Boolean);\nconst t = resp.tracking || {};\nconst utm = ['utm_source','utm_campaign','utm_medium','utm_content','utm_term']\n  .map(k => `${k}: ${t[k] || ''}`).join('\\n');\nconst hora = Number(new Intl.DateTimeFormat('pt-BR', {\n  timeZone: 'America/Sao_Paulo', hour: '2-digit', hourCycle: 'h23',\n}).format(new Date()));\nconst saudacao = hora < 12 ? 'Bom dia' : hora < 18 ? 'Boa tarde' : 'Boa noite';\nconst resumo = linhas.join('\\n\\n')\n  + '\\n\\n*Origens:*\\nFormulário: Agenda lotada ou não paga (yay forms)\\n' + utm;\nreturn [{ json: { ...$json, resumo, saudacao, leadPhone: val('6a92da4b8490fde669082a6a') } }];\n"
        },
