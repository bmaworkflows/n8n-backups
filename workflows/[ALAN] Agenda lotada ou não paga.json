      {
        "parameters": {
          "jsCode": "// O campo calendly do Yay devolve o link com scheduled_events/<uuid> quando agendou\nconst ans = $('Trata Webhook').item.json.response.answers || {};\nconst c = ans['6a958dd13928d17403056931']?.content;\nconst link = (typeof c === 'string' && c.includes('calendly.com')) ? c.trim() : null;\nlet eventUuid = null;\nif (link) {\n  const m = link.match(/scheduled_events\\/([0-9a-fA-F-]{36})/);\n  if (m) eventUuid = m[1];\n}\nreturn [{ json: { ...$json, agendou: !!eventUuid, calendlyLink: link, eventUuid } }];\n"
        },
