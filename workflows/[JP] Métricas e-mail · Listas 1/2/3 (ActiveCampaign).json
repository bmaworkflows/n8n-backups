      {
        "parameters": {
          "jsCode": "// Foto do dia só de quem já saiu (rascunho/agendada não entra no histórico).\nconst hoje = DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy');\nreturn $input.all()\n  .filter((i) => i.json['Enviados'] > 0)\n  .map((i) => {\n    const { ['Atualizado em']: _, ...resto } = i.json;\n    return { json: { 'Data': hoje, ...resto } };\n  });\n"
        },
