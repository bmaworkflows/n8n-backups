        ],
        "id": "d51e3ed3-a276-4927-ab34-bc784a819e14",
        "name": "Campanhas"
      },
      {
        "parameters": {
          "url": "=https://bmacoprodutora.api-us1.com/api/3/campaigns/{{ $json.id }}",
          "authentication": "predefinedCredentialType",
          "nodeCredentialType": "activeCampaignApi",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          480,
          80
        ],
        "id": "fe52a6f4-623b-46b0-a5c2-acd23d5d7b31",
        "name": "Busca campanha (AC)",
        "credentials": {
          "activeCampaignApi": {
            "id": "UB9gpytDjdRyLmed",
            "name": "Active JP"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Uma linha por campanha. Entrada: GET /campaigns/<id> do ActiveCampaign.\nconst LISTA = Object.fromEntries($('Campanhas').all().map((i) => [String(i.json.id), i.json.lista]));\nconst STATUS = { 0: 'rascunho', 1: 'agendada', 2: 'enviando', 3: 'pausada', 4: 'parada', 5: 'enviada', 6: 'desativada', 7: 'em revisão' };\nconst n = (v) => Number(v || 0);\nconst taxa = (a, b) => (b > 0 ? Math.round((a / b) * 10000) / 10000 : 0);\nconst agora = DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm');\n\nreturn $input.all().map(({ json }) => {\n  const c = json.campaign;\n  const enviados = n(c.send_amt), hard = n(c.hardbounces), soft = n(c.softbounces);\n  const entregues = Math.max(enviados - hard - soft, 0);\n  const abU = n(c.uniqueopens), clU = n(c.uniquelinkclicks), desc = n(c.unsubscribes);\n  return { json: {\n    'ID': n(c.id),\n    'E-mail': c.name,\n    'Lista': LISTA[String(c.id)] || '',\n    'Status': STATUS[c.status] || c.status,\n    'Enviado em': c.ldate ? DateTime.fromISO(c.ldate).setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm') : '',\n    'Enviados': enviados,\n    'Bounce permanente': hard,\n    'Bounce temporário': soft,\n    'Entregues': entregues,\n    'Taxa de bounce': taxa(hard + soft, enviados),\n    'Aberturas únicas': abU,\n    'Taxa de abertura': taxa(abU, entregues),\n    'Aberturas totais': n(c.opens),\n    'Cliques únicos': clU,\n    'Taxa de cliques': taxa(clU, entregues),\n    'Cliques/aberturas': taxa(clU, abU),\n    'Descadastros': desc,\n    'Taxa de descadastro': taxa(desc, entregues),\n    'Atualizado em': agora,\n  } };\n});\n"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          720,
          80
        ],
        "id": "56efd225-2a51-4df7-b28f-a8af3ab5bd6e",
        "name": "Calcula métricas"
      },
